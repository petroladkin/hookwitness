package web

import (
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/petroladkin/hookwitness/internal/emulate"
	"github.com/petroladkin/hookwitness/internal/store"
)

// favicon is inline so that browsers do not ask the server for
// /favicon.ico, which would land in the Unmatched register.
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%2324308C'/%3E%3Cpath d='M3 12V4M3 8h4M7 12V4M10 12l1.5-8 1.5 8' stroke='%23E6ECE7' stroke-width='1.6' fill='none'/%3E%3C/svg%3E"

templ layout(nav navView, pageTitle string) {
	<!DOCTYPE html>
	<html
		lang="en"
		if nav.Theme != "" {
			data-theme={ nav.Theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ colorScheme(nav.Theme) }/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"historyCacheSize":0}'/>
			<title>{ pageTitle } · Hookwitness</title>
			<link rel="icon" href={ templ.SafeURL(favicon) }/>
			<link rel="stylesheet" href={ templ.SafeURL(nav.Asset("app.css")) }/>
			<script src={ nav.Asset("vendor/htmx/htmx.min.js") } defer></script>
			<script src={ nav.Asset("vendor/htmx-ext-sse/sse.min.js") } defer></script>
			<script src={ nav.Asset("strip.js") } defer></script>
			<script src={ nav.Asset("feed.js") } defer></script>
			<script src={ nav.Asset("app.js") } defer></script>
		</head>
		<body>
			<div class="wrap">
				@masthead(nav)
				if nav.NoLogin && !nav.Bare {
					<p class="nologin" role="note">
						<b>No login.</b> Anyone who can open this page can read every request and change every endpoint.
						<a href={ templ.SafeURL(nav.Prefix + "/users") }>Add a user</a> to turn login on.
					</p>
				}
				{ children... }
				if nav.Build != "" {
					<footer class="build">Hookwitness { nav.Build }</footer>
				}
			</div>
		</body>
	</html>
}

templ masthead(nav navView) {
	<header class="mast">
		<a class="brand" href={ templ.SafeURL(nav.Prefix + "/") } title={ "Hookwitness " + nav.Build }>Hookwitness</a>
		if !nav.Bare {
			<nav class="sections" aria-label="Sections">
				<a href={ templ.SafeURL(nav.Prefix + "/") } aria-current={ tabCurrent(nav.section() == "endpoints") }>Endpoints</a>
				if nav.Admin {
					<a href={ templ.SafeURL(nav.Prefix + "/users") } aria-current={ tabCurrent(nav.section() == "users") }>Users</a>
				}
			</nav>
			<div class="status">
				if nav.OnRegister {
					<span class="rec" id="feed-state" data-state="connecting"><i aria-hidden="true"></i><span>Connecting</span></span>
				}
				<span class="addr">{ hostOf(nav.Catch) }</span>
				@accountMenu(nav)
			</div>
		}
	</header>
}

// accountMenu is everything about the person at the screen, behind their
// name: account and tokens, this browser's theme, log out. A details
// element, so it opens without scripts; with login off it holds the theme.
templ accountMenu(nav navView) {
	<details class="menu acct" data-menu>
		<summary>
			if nav.User != "" {
				{ nav.User }
			} else {
				Theme
			}
		</summary>
		<div class="menu-list">
			if nav.User != "" {
				<p class="menu-note">
					if nav.Admin {
						Admin: manages endpoints and users
					} else {
						User: manages endpoints
					}
				</p>
				<a class="menu-item" href={ templ.SafeURL(nav.Prefix + "/account") }>Account and tokens</a>
			}
			<div class="menu-theme"><span class="menu-label">Theme</span>@themeSwitch(nav)</div>
			if nav.User != "" {
				<form method="post" action={ templ.SafeURL(nav.Prefix + "/logout") }>
					<button class="menu-item" type="submit">Log out</button>
				</form>
			}
		</div>
	</details>
}

// registerPicker is a register's name, and the way to another register:
// the endpoints on, then those off, then Unmatched, each with its count.
templ registerPicker(nav navView, reg registerView) {
	<details class="menu pick" data-menu>
		<summary class="reg-name">{ title(reg) }</summary>
		<div class="menu-list">
			if nav.someOff() {
				<span class="menu-label">On</span>
			}
			for _, e := range nav.Endpoints {
				if e.Enabled {
					@pickItem(nav.registerURL(e.ID), e.Path, e.Count, nav.Current == e.ID, "menu-item")
				}
			}
			if nav.someOff() && !nav.someOn() {
				<span class="menu-none">None</span>
			}
			if nav.someOff() {
				<span class="menu-label">Off</span>
				for _, e := range nav.Endpoints {
					if !e.Enabled {
						@pickItem(nav.registerURL(e.ID), e.Path, e.Count, nav.Current == e.ID, "menu-item off")
					}
				}
			}
			@pickItem(nav.registerURL(store.Unmatched), "Unmatched", nav.Unmatched, nav.Current == store.Unmatched, "menu-item apart")
			<a class="menu-item apart" href={ templ.SafeURL(nav.Prefix + "/") }><span>All endpoints</span><span aria-hidden="true">→</span></a>
		</div>
	</details>
}

templ pickItem(href, name string, n int, current bool, class string) {
	<a class={ class } href={ templ.SafeURL(href) } aria-current={ tabCurrent(current) }><span>{ name }</span><span class="n">{ strconv.Itoa(n) }</span></a>
}

// themeSwitch chooses this browser's theme: a form, so it works without
// scripts; app.js applies the choice at once and posts it in the background.
templ themeSwitch(nav navView) {
	<form class="theme" method="post" action={ templ.SafeURL(nav.Prefix + "/theme") } aria-label="Theme">
		<input type="hidden" name="next" value={ nav.Here }/>
		for _, t := range themes {
			<button type="submit" name="theme" value={ t.value } aria-pressed={ strconv.FormatBool(nav.Theme == t.theme) } title={ t.title }>{ t.label }</button>
		}
	</form>
}

templ endpointsPage(nav navView, d endpointsDialog) {
	@layout(nav, "Endpoints") {
		<main class="sheet">
			<h1 class="title">Endpoints</h1>
			<p class="lede">
				An endpoint is an exact path on this server. Point a sender at it and every request that arrives is
				kept as evidence. Requests to any other path are answered 404 and kept under Unmatched.
			</p>
			<div class="toolbar">
				<div class="toolbar-note">
					<p class="note">
						<a href={ templ.SafeURL(nav.registerURL(store.Unmatched)) }>Unmatched requests</a>
						· { strconv.Itoa(nav.Unmatched) } kept
					</p>
				</div>
				if len(nav.Endpoints) > 0 {
					<a class="btn quiet" href={ templ.SafeURL(nav.Prefix + "/setup") } download>Export all</a>
				}
				<a class="btn quiet" href={ templ.SafeURL(nav.Prefix + "/?edit=import") }>Import</a>
				<a class="btn solid" href={ templ.SafeURL(nav.Prefix + "/?edit=new") }>New endpoint</a>
			</div>
			if len(d.Imported) > 0 {
				<p class="saved banner" role="status">
					Imported: { strings.Join(d.Imported, ", ") }.
					if d.Unset > 0 {
						{ plural(d.Unset, "secret has no value yet: the checks that use it give n/v until you set it", "secrets have no value yet: the checks that use them give n/v until you set them") } on the endpoint's Behaviour → Secrets.
					}
				</p>
			}
			if len(nav.Endpoints) == 0 {
				<p class="empty">No endpoints yet. Create one with New endpoint, then send it a request.</p>
			} else {
				<div class="scroll">
					<table class="eps">
						<thead>
							<tr><th>Path</th><th>Catch URL</th><th class="num">Kept</th><th>Last received</th><th><span class="sr">Actions</span></th></tr>
						</thead>
						<tbody>
							for _, e := range nav.Endpoints {
								<tr class={ templ.KV("off", !e.Enabled) }>
									<td>
										<a href={ templ.SafeURL(nav.registerURL(e.ID)) }>{ e.Path }</a>
										if n := unsetSecrets(e.Config); n > 0 {
											<a class="unset" href={ templ.SafeURL(nav.registerURL(e.ID) + "/behaviour?tab=secrets") }>{ plural(n, "secret", "secrets") } not set</a>
										}
										if rv := receiverOf(e.Config); rv != "" {
											<a class="tag receiver-badge" href={ templ.SafeURL(nav.registerURL(e.ID) + "/behaviour?tab=receiver") } title="Requests are forwarded here: live traffic leaves the server">→ { rv }</a>
										}
									</td>
									<td class="url">{ nav.Catch }{ e.Path }</td>
									<td class="num">{ strconv.Itoa(e.Count) }</td>
									<td class="when">{ lastSeen(e.LastAt) }</td>
									<td class="acts">
										<div class="row-acts">
											@switchForm(nav.registerURL(e.ID), e.Path, e.Enabled, nav.Prefix+"/")
											<a class="btn quiet" href={ templ.SafeURL(nav.registerURL(e.ID) + "/behaviour") }>Behaviour</a>
											@clearForm(nav, e.ID, nav.Prefix+"/", e.Path, e.Kept.Pinned)
											<form method="post" action={ templ.SafeURL(nav.registerURL(e.ID) + "/delete") } data-confirm={ "Delete " + e.Path + " and its " + strconv.Itoa(e.Count) + " requests?" }>
												<button class="btn quiet" type="submit">Delete</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if d.Import != nil {
				@importDialog(nav, *d.Import)
			}
			if d.Creating {
				<dialog class="modal" data-modal data-close={ nav.Prefix + "/" } open aria-labelledby="dialog-title">
					<form class="card" method="post" action={ templ.SafeURL(nav.Prefix + "/endpoints") }>
						<div class="modal-head">
							<h2 id="dialog-title">New endpoint</h2>
							<a class="close" href={ templ.SafeURL(nav.Prefix + "/") } aria-label="Close">×</a>
						</div>
						if d.FormErr != "" {
							<p class="error banner" role="alert">Not created: { d.FormErr }</p>
						}
						<label for="path">Path</label>
						<input
							id="path"
							name="path"
							value={ d.FormPath }
							placeholder="/stripe/webhooks"
							autocomplete="off"
							spellcheck="false"
							autofocus
							aria-describedby="path-help"
							if d.FormErr != "" {
								aria-invalid="true"
							}
						/>
						<p id="path-help" class="help">
							Leave it empty for a random path. Letters, digits and <code>. _ ~ -</code> between slashes;
							a trailing slash is part of the path.
						</p>
						<div class="acts">
							<button class="btn solid" type="submit">Create endpoint</button>
							<a class="btn quiet" href={ templ.SafeURL(nav.Prefix + "/") }>Cancel</a>
						</div>
					</form>
				</dialog>
			}
		</main>
	}
}

// importDialog imports a setup file in two steps: pick (or paste) it, then
// review where each endpoint goes and give secret values if wanted.
templ importDialog(nav navView, v importView) {
	<dialog class="modal" data-modal data-close={ nav.Prefix + "/" } open aria-labelledby="dialog-title">
		<form class="card import" method="post" action={ templ.SafeURL(nav.Prefix + "/import") } enctype="multipart/form-data">
			<div class="modal-head">
				<h2 id="dialog-title">Import endpoints</h2>
				<a class="close" href={ templ.SafeURL(nav.Prefix + "/") } aria-label="Close">×</a>
			</div>
			if v.Error != "" {
				<p class="error banner" role="alert">Not imported: { v.Error }</p>
			}
			if !v.Review {
				<label>Setup file <input type="file" name="file" accept=".json,application/json" autofocus/></label>
				<label for="setup-text">Or paste it</label>
				<textarea id="setup-text" name="text" rows="10" spellcheck="false" placeholder="{&#34;hookwitness&#34;: 1, &#34;endpoints&#34;: [...]}">{ v.Text }</textarea>
				<p class="help">A <code>.hookwitness.json</code> file exported from an endpoint's Behaviour page or with Export all. It holds the behaviour and the names of the secrets, never their values.</p>
				<div class="acts">
					<button class="btn solid" type="submit" name="op" value="review">Review</button>
					<a class="btn quiet" href={ templ.SafeURL(nav.Prefix + "/") }>Cancel</a>
				</div>
			} else {
				<textarea name="text" hidden>{ v.Text }</textarea>
				<p class="help">Nothing is imported until you press Import; then all of these or none.</p>
				for _, it := range v.Items {
					<fieldset class="masks import-item">
						<legend>{ it.Path } · { it.Summary }</legend>
						if it.Receiver != "" {
							<p class="banner warn">Forwards live traffic to <code>{ it.Receiver }</code>: requests to this endpoint leave the server and the receiver's answers come back to their senders. Only an admin can import a receiver.</p>
						}
						<label>Path <input name={ "path_" + strconv.Itoa(it.I) } value={ it.Target } required spellcheck="false" autocomplete="off"/></label>
						if it.Taken {
							<label class="check"><input type="checkbox" name={ "replace_" + strconv.Itoa(it.I) } checked?={ it.Replace }/> { it.Target } is already an endpoint: replace its behaviour (its requests, counter and on/off state stay)</label>
							if it.ToPrune > 0 {
								<p class="error banner" role="alert">Replacing sets the file's retention, which prunes { thousands(int64(it.ToPrune)) } of its requests at once.</p>
							}
						}
						for _, s := range it.Secrets {
							<label>
								{ s.Name } · { emulate.SecretKindTitle(s.Kind) }
								<input type="password" name={ "secret_" + strconv.Itoa(it.I) + "_" + s.Name } value="" autocomplete="new-password" spellcheck="false" placeholder="value (optional)"/>
							</label>
						}
						if len(it.Secrets) > 0 {
							<p class="help">
								A secret left empty is not set: its checks give n/v until you set it.
								if it.Taken {
									A replaced endpoint keeps the value it has for a secret of the same name and kind.
								}
							</p>
						}
					</fieldset>
				}
				<div class="acts">
					<button class="btn solid" type="submit" name="op" value="import">Import</button>
					<a class="btn quiet" href={ templ.SafeURL(nav.Prefix + "/?edit=import") }>Choose another file</a>
				</div>
			}
		</form>
	</dialog>
}

// switchForm turns an endpoint off or on; the switch shows its state.
templ switchForm(base, path string, enabled bool, next string) {
	<form method="post" action={ templ.SafeURL(base + "/switch") }>
		<input type="hidden" name="enabled" value={ strconv.FormatBool(!enabled) }/>
		<input type="hidden" name="next" value={ next }/>
		<button
			class="switch"
			type="submit"
			role="switch"
			aria-checked={ strconv.FormatBool(enabled) }
			aria-label={ "Catching at " + path }
			if enabled {
				title="On: catching. Turn off to send this path's requests to Unmatched."
			} else {
				title="Off: requests go to Unmatched. Turn on to catch them here again."
			}
		>
			<i aria-hidden="true"></i>
			if enabled {
				On
			} else {
				Off
			}
		</button>
	</form>
}

templ clearForm(nav navView, regID int64, next, what string, pinned int) {
	<form method="post" action={ templ.SafeURL(nav.registerURL(regID) + "/clear") } data-confirm={ clearQuestion(what, pinned) }>
		<input type="hidden" name="next" value={ next }/>
		<button class="btn quiet" type="submit">Clear</button>
	</form>
}

templ registerPage(nav navView, reg registerView, ex *exhibitView) {
	@layout(nav, title(reg)) {
		<div class="reg-bar">
			<div class="reg-id">
				@registerPicker(nav, reg)
				<span class="kept"><span id="kept" data-count="kept">{ strconv.Itoa(reg.Count) }</span> kept</span>
				if reg.Receiver != "" {
					<a class="tag receiver-badge" href={ templ.SafeURL(reg.Base + "/behaviour?tab=receiver") } title="Requests no rule takes are forwarded here: live traffic leaves the server">→ { reg.Receiver }</a>
				}
				@keepsLine(reg.Keeps)
			</div>
			<div class="reg-tools">
				if reg.ID == store.Unmatched {
					@clearForm(nav, reg.ID, reg.Base, "Unmatched", reg.Keeps.Pinned)
				} else {
					@switchForm(reg.Base, reg.Path, reg.Enabled, reg.Base)
					@clearForm(nav, reg.ID, reg.Base, reg.Path, reg.Keeps.Pinned)
					<a class="btn" href={ templ.SafeURL(reg.Base + "/behaviour") }>Behaviour</a>
				}
				<a class="btn" href={ templ.SafeURL(reg.Base + "?retention") }>Retention</a>
				<a class="btn" href={ templ.SafeURL(reg.Base + "?report") }>Report</a>
				if reg.ID != store.Unmatched {
					<a class="btn" href={ templ.SafeURL(reg.Base + "?draft") }>Draft schema</a>
				}
			</div>
		</div>
		<section class="strip" aria-label="Arrivals over the last 2 min">
			<canvas id="trace" aria-hidden="true" data-marks={ reg.Base + "/marks" }></canvas>
			<div class="legend">
				<span class="spans" role="group" aria-label="Range of the strip">
					<b>Last</b>
					<button type="button" data-span="2m" aria-pressed="true">2 min</button>
					<button type="button" data-span="10m" aria-pressed="false">10 min</button>
					<button type="button" data-span="1h" aria-pressed="false">1 h</button>
					<button type="button" data-span="6h" aria-pressed="false">6 h</button>
				</span>
				<span>height = body size · red: not 2xx · dashed: timeout · ×: dropped · red bar under the line: a failed check · same body bracketed · hatched: not kept · lightly hatched: only one lane kept · pin: pinned</span>
			</div>
		</section>
		<main class="desk">
			<section class="register" aria-label="Caught requests">
				if !reg.Enabled {
					<p class="banner off-note" role="status">
						Off: requests to this path are answered 404 and kept under
						<a href={ templ.SafeURL(nav.registerURL(store.Unmatched)) }>Unmatched</a>. Its behaviour, secrets,
						requests and counter stay as they are; turn it on to catch here again.
					</p>
				}
				if reg.Unset > 0 {
					<p class="banner off-note" role="status">
						{ plural(reg.Unset, "secret of this endpoint has no value yet, so the checks that use it give n/v:", "secrets of this endpoint have no value yet, so the checks that use them give n/v:") }
						<a href={ templ.SafeURL(reg.Base + "/behaviour?tab=secrets") }>set { pick(reg.Unset == 1, "it", "them") } on the Secrets tab</a>.
					</p>
				}
				if reg.Verdicts.On {
					<div class="verdict-counts">
						<span>Verdicts</span>
						<b class="v-pass"><span data-count="pass">{ strconv.Itoa(reg.Verdicts.Pass) }</span> pass</b>
						<b class="v-fail"><span data-count="fail">{ strconv.Itoa(reg.Verdicts.Fail) }</span> fail</b>
						<b class="v-nv"><span data-count="nv">{ strconv.Itoa(reg.Verdicts.NV) }</span> n/v</b>
						<b class="v-nv" hidden?={ reg.Verdicts.NC == 0 }><span data-count="nc">{ strconv.Itoa(reg.Verdicts.NC) }</span> n/c</b>
						<form method="post" action={ templ.SafeURL(reg.Base + "/recheck") } data-confirm={ "Re-check the " + strconv.Itoa(reg.Count) + " kept requests with the current checks, secrets and schemas? Their replies stay as sent." }>
							<button class="btn quiet" type="submit">Re-check <span data-count="kept">{ strconv.Itoa(reg.Count) }</span></button>
						</form>
					</div>
					if reg.Verdicts.Rechecked != "" {
						<p class="saved banner" role="status">Re-checked { reg.Verdicts.Rechecked } requests with the current checks, secrets and schemas.</p>
					}
				}
				if len(reg.Rows) == 0 {
					<p class="empty" id="register-empty">Nothing caught yet.</p>
				}
				<ol
					class="reg-list"
					id="register"
					aria-label="Caught requests, newest first"
					hx-ext="sse"
					sse-connect={ reg.Base + "/events?after=" + id(reg.Newest) + "&seq=" + id(reg.Seq) }
					sse-swap="request,update"
					hx-swap="afterbegin"
					data-selected={ id(reg.Selected) }
					data-seq={ id(reg.Seq) }
				>
					for _, r := range reg.Rows {
						@row(r)
					}
					if reg.More && len(reg.Rows) > 0 {
						@moreRow(reg.Base, reg.Rows[len(reg.Rows)-1].ID)
					}
				</ol>
			</section>
			<article class="exhibit" id="exhibit" aria-live="polite">
				if ex != nil {
					@exhibit(*ex)
				} else {
					@noExhibit(nav, reg)
				}
			</article>
		</main>
		if reg.Export != nil {
			@reportDialog(*reg.Export)
		}
		if reg.Draft != nil {
			@draftDialog(*reg.Draft)
		}
		if reg.Replay != nil {
			@replayDialog(*reg.Replay)
		}
		if reg.Retain != nil {
			@retentionDialog(*reg.Retain)
		}
	}
}

// keepsLine says what the register keeps by retention and what it lost.
templ keepsLine(k keepsView) {
	<span class="keeps" title="Retention: what this register keeps; the oldest beyond it are pruned">
		keeps { strconv.Itoa(k.Normal) } newest
		if k.NormalAge != "" {
			{ "for " + k.NormalAge }
		}
		if k.Anomalies > 0 {
			· { strconv.Itoa(k.Anomalies) } anomalies
			if k.AnomalyAge != "" {
				{ "for " + k.AnomalyAge }
			}
		}
		if k.Pinned > 0 {
			· <span data-count="pinned">{ strconv.Itoa(k.Pinned) }</span> pinned
		}
		if k.Pruned > 0 {
			· <span data-count="pruned">{ thousands(k.Pruned) }</span> pruned
		}
	</span>
}

// retentionDialog sets the register's own retention: two lanes (one for
// Unmatched), each a count and an age; empty fields take the defaults.
templ retentionDialog(v retentionDialogView) {
	<dialog class="modal" data-modal data-close={ v.Close } open aria-labelledby="dialog-title">
		<form class="card" method="post" action={ templ.SafeURL(v.Action) }>
			<div class="modal-head">
				<h2 id="dialog-title">Retention</h2>
				<a class="close" href={ templ.SafeURL(v.Close) } aria-label="Close">×</a>
			</div>
			if v.Error != "" {
				<p class="error banner" role="alert">Not saved: { v.Error }</p>
			}
			if v.Unmatched {
				<p class="help">The newest requests are kept; older ones are pruned, and with an age, anything older than it. Pinned requests are never pruned. Empty fields take the server's defaults.</p>
			} else {
				<p class="help">Normal requests and anomalies are kept apart, so a flood of good requests never pushes out a failure. An anomaly: not answered 2xx (an error, a timeout, a drop, a refusal), a failed verdict, or a redelivery (a repeated signature). Pinned requests are never pruned. Empty fields take the server's defaults.</p>
			}
			<div class="grid2 even">
				<label>
					Normal requests: keep the newest
					<input name="normal_count" inputmode="numeric" value={ v.NormalCount } placeholder={ strconv.Itoa(v.DefaultNormal) } aria-invalid?={ v.Field == "normal_count" }/>
				</label>
				<label>
					Keep them for at most
					<input name="normal_age" value={ v.NormalAge } placeholder="no limit, or 7d, 36h, 90m" spellcheck="false" aria-invalid?={ v.Field == "normal_age" }/>
				</label>
			</div>
			if !v.Unmatched {
				<div class="grid2 even">
					<label>
						Anomalies: keep the newest
						<input name="anomaly_count" inputmode="numeric" value={ v.AnomalyCount } placeholder={ strconv.Itoa(v.DefaultAnomaly) } aria-invalid?={ v.Field == "anomaly_count" }/>
					</label>
					<label>
						Keep them for at most
						<input name="anomaly_age" value={ v.AnomalyAge } placeholder="no limit, or 30d" spellcheck="false" aria-invalid?={ v.Field == "anomaly_age" }/>
					</label>
				</div>
				<p class="help">0 anomalies: no separate lane; anomalies count as normal requests.</p>
			}
			if v.ToPrune > 0 {
				<p class="error banner" role="alert">Saving prunes { thousands(int64(v.ToPrune)) } { pick(v.ToPrune == 1, "request", "requests") } now. Pinned ones stay.</p>
				<input type="hidden" name="confirm" value={ strconv.Itoa(v.ToPrune) }/>
			}
			<div class="acts">
				if v.ToPrune > 0 {
					<button class="btn solid danger" type="submit">Save and prune { thousands(int64(v.ToPrune)) }</button>
				} else {
					<button class="btn solid" type="submit">Save</button>
				}
				<button class="btn quiet" type="submit" name="op" value="defaults">Use the server's defaults</button>
				<a class="btn quiet" href={ templ.SafeURL(v.Close) }>Close</a>
			</div>
		</form>
	</dialog>
}

// replayDialog sends the request on show again to a URL; the page waits for
// the answer (up to the timeout) and then shows it under the request.
templ replayDialog(v replayDialogView) {
	<dialog class="modal" data-modal data-close={ v.Close } open aria-labelledby="dialog-title">
		<form class="card" method="post" action={ templ.SafeURL(v.Action) } data-busy={ "Sending… (up to " + span(v.Timeout) + ")" }>
			<div class="modal-head">
				<h2 id="dialog-title">Replay</h2>
				<a class="close" href={ templ.SafeURL(v.Close) } aria-label="Close">×</a>
			</div>
			if v.Error != "" {
				<p class="error banner" role="alert">Not sent: { v.Error }</p>
			}
			if v.Blocked != "" {
				<p class="error banner" role="alert">{ v.Blocked }</p>
			}
			<p class="help">
				Sends this request again to your handler, byte for byte: the body unchanged and the { strconv.Itoa(v.Lines) } header
				lines in the order and letter case they arrived. Its answer is kept under the request. If your handler refuses the
				replay too, the bytes were not changed on the way: look at its verification.
			</p>
			<label>
				Target URL
				<input name="url" type="url" value={ v.URL } required spellcheck="false" autocomplete="off" autofocus aria-invalid?={ v.Field == "url" }/>
			</label>
			<fieldset class="masks">
				<legend>What changes</legend>
				<label class="check"><input type="checkbox" name="host" value="received" checked?={ v.KeepHost }/> Keep the received Host line</label>
				<label class="check"><input type="checkbox" name="insecure_tls" value="true" checked?={ v.Insecure }/> Skip certificate verification</label>
				<ul class="help">
					<li>Host names the target unless kept; it stays in its place.</li>
					<li>Skipping verification is for a local https handler with a self-signed certificate; the replay records it.</li>
					if v.Proto != "" && v.Proto != "HTTP/1.1" {
						<li>It came as { v.Proto } and goes as HTTP/1.1.</li>
					}
					if v.Chunked {
						<li>It came chunked: the body goes as one chunk, without chunk extensions or trailers.</li>
					}
					<li>Redirects are not followed; the answer is awaited up to { span(v.Timeout) }.</li>
					if v.Policy != "" {
						<li>Targets on this server: { v.Policy }.</li>
					} else {
						<li>Link-local and cloud-metadata addresses are refused.</li>
					}
				</ul>
			</fieldset>
			<div class="acts">
				<button class="btn solid" type="submit" disabled?={ v.Blocked != "" }>Send</button>
				<a class="btn quiet" href={ templ.SafeURL(v.Close) }>Close</a>
			</div>
		</form>
	</dialog>
}

// receiverSection is the request's exchange with its endpoint's receiver:
// where it went, what the receiver answered, what was sent.
templ receiverSection(x exhibitView) {
	<section id="receiver" aria-label="Receiver">
		<h2>Receiver</h2>
		if x.Outcome.NotForwarded {
			<p class="note">Not forwarded: rule { strconv.Itoa(x.Outcome.Rule) } took this request, and the receiver never saw it.</p>
		} else if x.Outcome.Forward.Pending {
			<p class="note">Being forwarded to <code>{ x.Outcome.Forward.Target }</code>…</p>
		} else if e := x.Exchange; e != nil {
			<div class="replay">
				<p>
					<span class={ "rstamp", templ.KV("bad", !e.good()) }>{ e.stamp() }</span>
					<span class="rurl">{ e.URL }</span>
					if e.Status != 0 {
						<span class="rmeta">· { millisOf(e.Duration) }</span>
					}
				</p>
				if e.ByRule > 0 {
					<p class="note">Rule { strconv.Itoa(e.ByRule) } took it and the sender got the rule's answer; the receiver got it too.</p>
				}
				if e.SenderLeft > 0 {
					<p class="note">The sender gave up after { millisOf(e.SenderLeft) }; the exchange went on for { millisOf(time.Duration(x.Outcome.Forward.Ms) * time.Millisecond) }.</p>
				}
				if e.Error != "" {
					<p class="note">No answer passed back: <code>{ e.Error }</code></p>
				}
				for _, n := range e.Notes {
					<p class="note">{ n }.</p>
				}
				if e.Insecure {
					<p class="note">The receiver's certificate was not verified.</p>
				}
				if e.Status != 0 {
					<h3>The receiver's answer · { strconv.Itoa(len(e.Headers)) } header lines · first byte after { millisOf(e.TTFB) }</h3>
					<div class="scroll">
						<table class="kv">
							<tbody>
								for _, hd := range e.Headers {
									<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
								}
							</tbody>
						</table>
					</div>
					switch e.Body.Kind {
						case bodyEmpty:
							<p class="note">No body.</p>
						case bodyJSON, bodyText:
							<pre class="body sent">{ e.Body.Text }</pre>
						case bodyBinary:
							<p class="note">Binary, { size(e.Size) }, kept as it arrived (never decompressed). The first bytes:</p>
							<pre class="body hex">{ e.Body.Hex }</pre>
					}
					if e.Cut {
						if e.Size < 0 {
							<p class="note">The answer ended before its end; what arrived is kept.</p>
						} else {
							<p class="note">Only the first 64 KiB of { size(e.Size) } are kept.</p>
						}
					}
					if e.Body.Kind != bodyEmpty {
						<p><a href={ templ.SafeURL(e.Download) } download>Download the receiver's answer body</a></p>
					}
				}
				if e.Line != "" {
					<h3>Sent · { strconv.Itoa(len(e.Sent)) } header lines · Host { hostWord(e.Host) }</h3>
					<pre class="body line">{ e.Line }</pre>
					<div class="scroll">
						<table class="kv">
							<tbody>
								for _, hd := range e.Sent {
									<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		} else {
			<p class="note">Forwarded to <code>{ x.Outcome.Forward.Target }</code>; the exchange was not kept.</p>
		}
	</section>
}

// replays are the request's replays, newest first: the target, its answer
// and what was sent.
templ replays(x exhibitView) {
	<section id="replays" aria-label="Replays">
		<h2>Replays · { strconv.Itoa(len(x.Replays)) }</h2>
		<ol class="replays">
			for i, rp := range x.Replays {
				<li id={ "replay-" + id(rp.ID) }>
					<details class="replay" open?={ i == 0 }>
						<summary>
							<span class={ "rstamp", templ.KV("bad", !rp.good()) }>{ rp.stamp() }</span>
							<span class="rurl">{ rp.URL }</span>
							<span class="rmeta">
								{ fullTime(rp.At) }
								if rp.By != "" {
									· { rp.By }
								}
								if rp.Status != 0 {
									· { millisOf(rp.Duration) }
								}
							</span>
						</summary>
						if rp.Error != "" {
							<p class="note">No complete answer: <code>{ rp.Error }</code></p>
						}
						for _, n := range rp.Notes {
							<p class="note">{ n }.</p>
						}
						if rp.Insecure {
							<p class="note">The target's certificate was not verified.</p>
						}
						if rp.Status != 0 {
							<h3>Answer · { strconv.Itoa(len(rp.Headers)) } header lines · first byte after { millisOf(rp.TTFB) }</h3>
							<div class="scroll">
								<table class="kv">
									<tbody>
										for _, hd := range rp.Headers {
											<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
										}
									</tbody>
								</table>
							</div>
							switch rp.Body.Kind {
								case bodyEmpty:
									<p class="note">No body.</p>
								case bodyJSON, bodyText:
									<pre class="body sent">{ rp.Body.Text }</pre>
								case bodyBinary:
									<p class="note">Binary, { size(rp.Size) }, kept as it arrived (never decompressed). The first bytes:</p>
									<pre class="body hex">{ rp.Body.Hex }</pre>
							}
							if rp.Cut {
								if rp.Size < 0 {
									<p class="note">The answer ended before its end; what arrived is kept.</p>
								} else {
									<p class="note">Only the first 1 MiB of { size(rp.Size) } is kept.</p>
								}
							}
							if rp.Body.Kind != bodyEmpty {
								<p><a href={ templ.SafeURL(rp.Download) } download>Download the answer body</a></p>
							}
						}
						<h3>Sent · { strconv.Itoa(len(rp.Sent)) } header lines</h3>
						<pre class="body line">{ rp.Line }</pre>
						<div class="scroll">
							<table class="kv">
								<tbody>
									for _, hd := range rp.Sent {
										<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
									}
								</tbody>
							</table>
						</div>
					</details>
				</li>
			}
		</ol>
	</section>
}

templ reportDialog(v exportView) {
	<dialog class="modal" data-modal data-close={ v.Close } open aria-labelledby="dialog-title">
		<form class="card" method="get" action={ templ.SafeURL(v.Action) }>
			<div class="modal-head">
				<h2 id="dialog-title">Report</h2>
				<a class="close" href={ templ.SafeURL(v.Close) } aria-label="Close">×</a>
			</div>
			if v.Error != "" {
				<p class="error banner" role="alert">No report: { v.Error }</p>
			}
			<p class="help">Evidence to attach to a ticket: the requests, what Hookwitness answered and every verdict, with a summary on top. Times are UTC.</p>
			<div class="grid2 even">
				<label>
					Format
					<select name="format" aria-invalid?={ v.Field == "format" }>
						<option value="html" selected?={ v.Format == "html" }>HTML, one file</option>
						<option value="md" selected?={ v.Format == "md" }>Markdown</option>
						<option value="pdf" selected?={ v.Format == "pdf" }>PDF, A4</option>
					</select>
				</label>
				<label>
					Requests
					<select name="scope" aria-invalid?={ v.Field == "scope" }>
						<option value="all" selected?={ v.Scope == "all" }>All { strconv.Itoa(v.Count) } kept</option>
						<option value="range" selected?={ v.Scope == "range" }>Received in a time range</option>
						<option value="picked" selected?={ v.Scope == "picked" }>Picked by number</option>
					</select>
				</label>
			</div>
			<label>
				Images in the requests
				<select name="images">
					<option value="shown" selected?={ v.Images == "shown" }>Shown (HTML and PDF), listed (Markdown)</option>
					<option value="listed" selected?={ v.Images == "listed" }>Listed only: a smaller file</option>
				</select>
			</label>
			if v.HasSetup {
				<fieldset class="masks">
					<legend>Setup</legend>
					<p class="help">The endpoint's checks, schemas, rules, replies, variables and secret names (never their values), as they are now.</p>
					<label class="check"><input type="checkbox" name="setup" value="true" checked?={ v.Setup }/> Add the endpoint's setup</label>
				</fieldset>
			}
			<div class="grid2 even for-range">
				<label>From, UTC <input type="datetime-local" name="from" step="0.001" value={ v.From } aria-invalid?={ v.Field == "from" }/></label>
				<label>To, UTC <input type="datetime-local" name="to" step="0.001" value={ v.To } aria-invalid?={ v.Field == "to" }/></label>
			</div>
			<label class="for-picked">
				Request numbers
				<input name="pick" value={ v.Pick } placeholder="3, 5-9" spellcheck="false" autocomplete="off" aria-invalid?={ v.Field == "pick" }/>
			</label>
			<fieldset class="masks">
				<legend>Mask header values</legend>
				<p class="help">Masked values are replaced by their length, e.g. •••• 71 chars; signatures taken from them in verdicts too.</p>
				<div class="mask-list">
					for _, m := range v.Masks {
						<label class="check"><input type="checkbox" name="mask" value={ m.Name } checked?={ m.On }/> <code>{ m.Name }</code></label>
					}
				</div>
				<label>Other headers <input name="mask_other" value={ v.Other } placeholder="X-Api-Key, X-Session" spellcheck="false" autocomplete="off" aria-invalid?={ v.Field == "mask_other" }/></label>
			</fieldset>
			<div class="acts">
				<button class="btn solid" type="submit">Download report</button>
				<a class="btn quiet" href={ templ.SafeURL(v.Close) }>Close</a>
			</div>
		</form>
	</dialog>
}

// draftDialog picks the requests a schema is drafted from; the schema
// editor opens on the draft, and nothing is stored until it is saved.
templ draftDialog(v draftDialogView) {
	<dialog class="modal" data-modal data-close={ v.Close } open aria-labelledby="dialog-title">
		<form class="card" method="get" action={ templ.SafeURL(v.Action) }>
			<div class="modal-head">
				<h2 id="dialog-title">Draft schema</h2>
				<a class="close" href={ templ.SafeURL(v.Close) } aria-label="Close">×</a>
			</div>
			<input type="hidden" name="tab" value="schemas"/>
			<input type="hidden" name="edit" value="schema-draft"/>
			<p class="help">A JSON Schema from what these requests' bodies have in common: types, keys (required when every body has them), array items, formats. You review it in the schema editor; nothing is saved until you save it.</p>
			if len(v.Values) > 0 {
				<label>
					From
					<select name="by">
						<option value="value" selected?={ v.By == "value" }>all requests with the same { strings.TrimPrefix(v.Label, "JSON Schema by ") }</option>
						<option value="pick" selected?={ v.By == "pick" }>requests picked by number</option>
					</select>
				</label>
				<label class="for-value">
					Value
					<select name="value">
						for _, c := range v.Values {
							<option value={ c.Value } selected?={ c.Value == v.Value }>{ c.Value } · { strconv.Itoa(c.N) }</option>
						}
					</select>
				</label>
			} else {
				<input type="hidden" name="by" value="pick"/>
			}
			<label class="for-pick">
				Request numbers
				<input name="pick" value={ v.Pick } placeholder="3, 5-9" spellcheck="false" autocomplete="off" autofocus/>
			</label>
			<div class="acts">
				<button class="btn solid" type="submit">Draft schema</button>
				<a class="btn quiet" href={ templ.SafeURL(v.Close) }>Close</a>
			</div>
		</form>
	</dialog>
}

templ noExhibit(nav navView, reg registerView) {
	<div class="ex-empty">
		if reg.ID == store.Unmatched {
			<p>Requests to paths that no endpoint has land here, answered 404, so a typo in a sender’s URL shows up at once.</p>
		} else if len(reg.Rows) == 0 {
			<p>Point a sender at this endpoint, or send a test request:</p>
			<pre class="try">{ tryCommand(nav.Catch, reg.Path) }</pre>
			<p>It appears in the register on the left as it arrives.</p>
		} else {
			<p>Choose a request in the register to see it in full.</p>
		}
	</div>
}

templ moreRow(base string, beforeID int64) {
	<li class="more">
		<button class="btn quiet" type="button" hx-get={ base + "/rows?before=" + id(beforeID) } hx-target="closest li" hx-swap="outerHTML">Show older</button>
	</li>
}

templ rowsChunk(rows []rowView, more bool, base string) {
	for _, r := range rows {
		@row(r)
	}
	if more && len(rows) > 0 {
		@moreRow(base, rows[len(rows)-1].ID)
	}
}

templ row(r rowView) {
	<li
		class={ "row", templ.KV("bad", r.mark() != "ok"), templ.KV("fresh", r.Fresh) }
		id={ "req-" + id(r.ID) }
		data-id={ id(r.ID) }
		data-at={ strconv.FormatInt(r.At.UnixMilli(), 10) }
		data-size={ strconv.FormatInt(r.Size, 10) }
		data-group={ r.Group }
		data-mark={ r.mark() }
		data-lane={ r.lane() }
		if r.Verdict != "" {
			data-verdict={ r.Verdict }
		}
	>
		<a href={ templ.SafeURL(r.Href) } hx-get={ r.Href } hx-target="#exhibit" hx-push-url="true" hx-swap="innerHTML">
			<span class="no">{ id(r.No) }</span>
			<span class="m">
				{ r.Method } <em>{ size(r.Size) }</em>
				if r.Verdict != "" {
					<span class={ "tag", "verdict-" + verdictClass(r.Verdict) }>checks { r.Verdict }</span>
				}
				if r.Repeat != "" {
					<span class="repeat" title={ r.Repeat }>{ repeatShort(r.Repeat) }</span>
				}
				if r.Pinned {
					<span class="tag pinned" title="Pinned: never pruned by retention">pinned</span>
				}
			</span>
			<span class="t">{ clock(r.At) }</span>
			<span class="ev">
				if r.TooLarge && r.Outcome.Source == emulate.FromBusy {
					Busy: 503, body not kept
				} else if r.TooLarge {
					Refused: body over the limit
				} else if r.Detail != "" {
					{ r.Detail }
				} else if r.Size == 0 {
					No body
				}
				if r.Delivery > 1 {
					<span class="retry">retry { strconv.Itoa(r.Delivery - 1) }</span>
				}
				if r.Replays > 0 {
					<span class="replayed" title={ plural(r.Replays, "replay", "replays") }>replayed { strconv.Itoa(r.Replays) }</span>
				}
				if t := r.tag(); t != "" {
					<span class={ "tag", "mark-" + r.mark() }>{ t }</span>
				}
				if m := r.Outcome.ReceiverMark(); m != "" && r.Outcome.Source != emulate.FromForward {
					<span class="tag receiver-mark">{ m }</span>
				}
			</span>
		</a>
	</li>
}

templ exhibit(x exhibitView) {
	<div class="ex-top" data-exhibit={ id(x.ID) }>
		<div class="ex-no"><small>№</small>{ id(x.No) }</div>
		<div class="ex-line">
			<div class="ex-path">
				<b>{ x.Method }</b> { x.Path }
				if x.RawQuery != "" {
					<span class="q">?{ x.RawQuery }</span>
				}
			</div>
			<div class="ex-meta">
				<span>received <b>{ fullTime(x.At) }</b></span>
				<span>from <b>{ host(x.From) }</b></span>
				<span>body <b>{ size(x.Size) }</b></span>
				<span>{ x.Proto }</span>
				if x.Event != nil && *x.Event != "" {
					<span>
						attempt <b>{ strconv.Itoa(x.Delivery) }</b> of event <code>{ *x.Event }</code>
					</span>
				} else if x.Delivery > 1 {
					<span>delivery <b>{ strconv.Itoa(x.Delivery) }</b> of this body</span>
				}
			</div>
		</div>
		<div class={ "stamp", templ.KV("bad", !x.Outcome.Good()) }>
			{ x.Outcome.Stamp() }
			if w := x.Outcome.StampWhy(); w != "" {
				<small>{ w }</small>
			}
		</div>
	</div>
	<div class="ex-actions">
		if !x.TooLarge && x.Size > 0 {
			<a class="btn" href={ templ.SafeURL(x.Download) } download>Download body</a>
		}
		<a class="btn" href={ templ.SafeURL(x.Self + "?report") }>Report</a>
		if !x.Unmatch {
			<a class="btn" href={ templ.SafeURL(x.Self + "?draft") }>Draft schema</a>
		}
		if x.CanReplay {
			<a class="btn" href={ templ.SafeURL(x.Self + "?replay") }>Replay</a>
		}
		<form method="post" action={ templ.SafeURL(x.PinURL) }>
			<input type="hidden" name="next" value={ x.Self }/>
			if x.Pinned {
				<input type="hidden" name="pinned" value="false"/>
				<button class="btn" type="submit" title="Pinned: retention never prunes it. Unpin to return it to its lane.">Unpin</button>
			} else {
				<input type="hidden" name="pinned" value="true"/>
				<button class="btn" type="submit" title="Retention never prunes a pinned request">Pin</button>
			}
		</form>
	</div>
	if len(x.Images) > 0 {
		@images(x)
	}
	<h2>Body</h2>
	if x.TooLarge && x.Outcome.Source == emulate.FromBusy {
		<div class="too">
			Hookwitness was reading other bodies up to its <code>-max-inflight</code> limit when this one
			arrived ({ size(x.Size) } declared), so it answered 503 with <code>Retry-After</code> and did not keep the body.
			Should that happen under normal load, start hookwitness with a larger <code>-max-inflight</code>.
		</div>
	} else if x.TooLarge {
		<div class="too">
			The sender tried to deliver { size(x.Size) }. The limit is { size(x.Limit) }, so the body was not kept
			if x.Unmatch {
				(and the path has no endpoint: the answer was 404).
			} else {
				and Hookwitness answered 413.
			}
			Start hookwitness with a larger <code>-max-body</code> to catch it.
		</div>
	} else {
		if x.Kept < x.Size {
			<p class="note">
				Only the first { size(x.Kept) } of { size(x.Size) } were kept: the path has no endpoint, and the Unmatched
				register keeps the start of a body.
			</p>
		}
		switch x.Body.Kind {
			case bodyEmpty:
				<p class="note">No body.</p>
			case bodyJSON:
				if x.BadPaths > 0 {
					<p class="note">Marked in the body: where a schema check found problems.</p>
				}
				<pre class="body json">
					for _, t := range x.Body.JSON {
						if t.Class == "" && !t.Bad && !t.Image {
							{ t.Text }
						} else {
							<span class={ t.Class, templ.KV("bad", t.Bad), templ.KV("img", t.Image) }>{ t.Text }</span>
							if t.Elided != "" {
								<span class="elided">{ t.Elided }</span>
							}
						}
					}
				</pre>
				<details class="raw">
					<summary>Raw view</summary>
					<pre class="body">{ x.Body.Text }</pre>
				</details>
			case bodyText:
				<pre class="body">{ x.Body.Text }</pre>
				if x.Body.Truncated {
					<p class="note">Only the first 256 KiB are shown; download the body for all of it.</p>
				}
			case bodyBinary:
				<p class="note">Binary, { size(x.Size) }. The first bytes:</p>
				<pre class="body hex">{ x.Body.Hex }</pre>
		}
	}
	@verdicts(x)
	@answer(x)
	if x.Outcome.Forward != nil || x.Outcome.NotForwarded {
		@receiverSection(x)
	}
	if len(x.Replays) > 0 {
		@replays(x)
	}
	<h2>Headers · { strconv.Itoa(len(x.Headers)) }</h2>
	<div class="scroll">
		<table class="kv">
			<tbody>
				for _, hd := range x.Headers {
					<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
				}
			</tbody>
		</table>
	</div>
	<h2>Query</h2>
	if len(x.Query) == 0 {
		<p class="note">No query string.</p>
	} else {
		<div class="scroll">
			<table class="kv">
				<tbody>
					for _, q := range x.Query {
						<tr><th>{ q.Name }</th><td>{ q.Value }</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ images(x exhibitView) {
	<h2>Images · { strconv.Itoa(len(x.Images)) }</h2>
	<ul class="images">
		for _, im := range x.Images {
			<li class={ templ.KV("bad", im.Error != "") }>
				if im.Src != "" {
					<button type="button" class="thumb" data-full={ im.Src } data-download={ im.Download } data-title={ im.Label } aria-label={ "Open " + im.Label + " full size" }>
						<img src={ im.Src } alt={ "The image at " + im.Label } loading="lazy"/>
					</button>
				} else {
					<div class={ "thumb", "none", templ.KV("hint", im.Hint != "") } aria-hidden="true">?</div>
				}
				<div class="img-text">
					<code>{ im.Label }</code>
					<span class="note">{ im.Note }</span>
					if im.Error != "" {
						<span class="error">{ im.Error }</span>
					}
					if im.Hint != "" {
						<span class="note">{ im.Hint }</span>
					}
					if im.Download != "" {
						<a href={ templ.SafeURL(im.Download) } download>Download</a>
					}
				</div>
			</li>
		}
	</ul>
	<dialog class="viewer" id="viewer" aria-label="Image">
		<div class="viewer-bar">
			<code class="viewer-title"></code>
			<button type="button" class="btn quiet" data-viewer="zoom" aria-pressed="false">1:1</button>
			<a class="btn quiet" data-viewer="download" href="#" download>Download</a>
			<button type="button" class="btn quiet" data-viewer="close">Close</button>
		</div>
		<div class="viewer-stage"><img alt=""/></div>
	</dialog>
}

templ notFoundPage(nav navView, msg string) {
	@layout(nav, "Not found") {
		<main class="sheet">
			<h1 class="title">Not found</h1>
			<p class="lede">{ msg }</p>
			<p><a href={ templ.SafeURL(nav.Prefix + "/") }>Back to the endpoints</a></p>
		</main>
	}
}

// answer is what Hookwitness did with the request.
templ verdicts(x exhibitView) {
	if len(x.Verdicts) > 0 {
		<h2>Verdicts</h2>
		<div class="verdicts">
			for _, v := range x.Verdicts {
				<div class={ "verdict", "verdict-" + verdictClass(string(v.Result)) }>
					<div class="vstamp">{ vstamp(v) }</div>
					<p class="note">{ v.Reason }<span class="when">{ " · check " + strconv.Itoa(v.Check) + " · checked " + fullTime(v.At) }</span></p>
					if v.Note != "" {
						<p class="note repeat">{ v.Note }</p>
					}
					if len(v.Problems) > 0 {
						<div class="scroll">
							<table class="kv problems">
								<tbody>
									for _, pr := range v.Problems {
										<tr><th>{ problemPath(pr.Path) }</th><td><code>{ pr.Keyword }</code> { pr.Message }</td></tr>
									}
								</tbody>
							</table>
						</div>
						if v.Total > len(v.Problems) {
							<p class="note">… and { strconv.Itoa(v.Total - len(v.Problems)) } more ({ strconv.Itoa(v.Total) } in all).</p>
						}
					}
					if v.Expected != "" || v.Received != "" {
						<div class="scroll">
							<table class="kv">
								<tbody>
									<tr><th>expected</th><td>{ v.Expected }</td></tr>
									<tr><th>received</th><td>{ v.Received }</td></tr>
								</tbody>
							</table>
						</div>
					}
				</div>
			}
		</div>
	}
}

templ answer(x exhibitView) {
	if x.Outcome.Source != "" {
		<h2>Answer</h2>
		<div class="answer">
			<p class="note">
				{ answerText(x.Outcome) }
				if x.Outcome.Error != "" {
					<code>{ x.Outcome.Error }</code>
				}
			</p>
			if len(x.Outcome.Headers) > 0 {
				<div class="scroll">
					<table class="kv">
						<tbody>
							for _, hd := range x.Outcome.Headers {
								<tr><th>{ hd.Name }</th><td>{ hd.Value }</td></tr>
							}
						</tbody>
					</table>
				</div>
			}
			if x.Outcome.Body != "" {
				<pre class="body sent">{ x.Outcome.Body }</pre>
			}
			if x.Outcome.BodyBase64 != "" {
				<p class="note">The body is not UTF-8; its bytes, in base64:</p>
				<pre class="body sent">{ x.Outcome.BodyBase64 }</pre>
			}
			if x.Outcome.Cut {
				<p class="note">Only the first 64 KiB of the reply are kept.</p>
			}
			if x.Outcome.Withheld != "" {
				<p class="note">The configured reply's { x.Outcome.Withheld }.</p>
			}
		</div>
	}
}

templ behaviourPage(nav navView, b behaviourView) {
	@layout(nav, "Behaviour · "+b.Path) {
		<main class="sheet behaviour">
			<p class="crumb"><a href={ templ.SafeURL(b.Base) }>{ b.Path }</a></p>
			<div class="title-row">
				<h1 class="title">Behaviour</h1>
				<a class="btn quiet" href={ templ.SafeURL(b.Base + "/setup") } download>Export setup</a>
			</div>
			<p class="lede">
				How this endpoint answers. Checks run first and can refuse a request; then the first rule whose
				condition holds decides; otherwise the default reply. Changes apply to the next request.
			</p>
			<nav class="tabs" aria-label="Behaviour">
				for _, t := range behaviourTabs {
					<a href={ templ.SafeURL(b.Base + "/behaviour?tab=" + t) } aria-current={ tabCurrent(b.Tab == t) }>
						{ tabTitle(t) }
						if n := tabCount(b.Config, t); n != "" {
							<small>{ n }</small>
						}
					</a>
				}
			</nav>
			switch b.Tab {
				case "checks":
					@toolbar(b, "check-new", "New check") {
						<p class="note">Required headers refuse a request without them. Authorization and JSON Schema checks record a verdict on every request and refuse only when enforced. Refused requests are not counted.</p>
						<p class="note event-line">
							Event id: <b>{ b.Config.EventWords() }</b> ·
							<a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=event") }>Edit</a>
						</p>
					}
					@checkList(b)
				case "receiver":
					@toolbar(b, "receiver", receiverAction(b)) {
						<p class="note">A receiver makes this endpoint a recorder in the middle: each request that passes the checks and that no rule takes goes on to it as it arrived, and its answer goes back to the sender. Both sides are kept.</p>
						if !b.MayForward {
							<p class="note">Only an admin can change where requests are forwarded.</p>
						}
					}
					@receiverSummary(b)
				case "default":
					@toolbar(b, "default", "Edit default reply") {
						<p class="note">{ defaultNote(b.Config) }</p>
					}
					@replySummary(b.Config.Default)
				case "secrets":
					@toolbar(b, "secret-new", "New secret") {
						<p class="note">Signing keys and tokens for authorization checks. Write-only: a saved value is never shown again, only its fingerprint. Test and staging secrets only.</p>
					}
					@secretList(b)
				case "schemas":
					@toolbar(b, "schema-new", "New schema") {
						<p class="note">JSON Schemas for schema checks (draft-04 to 2020-12; 2020-12 when <code>$schema</code> is absent). A schema refers to another one by name, as <code>{ `{"$ref": "Address"}` }</code>; nothing is ever fetched.</p>
					}
					@schemaList(b)
				case "vars":
					@toolbar(b, "var-new", "New variable") {
						<p class="note">Test values for templates, as <code>{ "{{.Var.NAME}}" }</code>. Stored in plain text: never real secrets.</p>
					}
					@varList(b)
				default:
					@toolbar(b, "rule-new", "New rule") {
						<form class="counter" id="counter" method="post" action={ templ.SafeURL(b.Base + "/behaviour") }>
							<input type="hidden" name="op" value="counter-reset"/>
							<span class="note"><b class="big">{ i64(b.Counter) }</b> counted since the reset · { clockText(b.StartedAt, b.Now) }</span>
							<button class="btn quiet" type="submit">Reset counter and clock</button>
						</form>
					}
					@ruleList(b)
			}
			if b.Editor != nil {
				@editorDialog(b, b.Editor)
			}
		</main>
	}
}

// toolbar holds a tab's note and its one main action, always in the same
// place; the outcome of the last edit goes under it.
templ toolbar(b behaviourView, edit, label string) {
	<div class="toolbar">
		<div class="toolbar-note">
			{ children... }
		</div>
		if label != "" {
			<a class="btn solid" href={ templ.SafeURL(b.Base + "/behaviour?tab=" + tabOf(edit) + "&edit=" + edit) }>{ label }</a>
		}
	</div>
	if b.NoDraft != "" {
		<p class="error banner" role="alert">No draft: { b.NoDraft }.</p>
	} else if b.Error != "" && b.Editor == nil {
		<p class="error banner" role="alert">Not saved: { b.Error }</p>
	} else if name := unusedSaved(b); name != "" {
		<p class="saved banner" role="status">
			Secret saved. It does nothing until a check uses it:
			<a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=check-new&secret=" + name) }>add a check that uses { name }</a>.
		</p>
	} else if b.Saved != "" {
		<p class="saved banner" role="status">{ savedText(b.Saved) }</p>
	}
}

templ rowActions(b behaviourView, kind string, i, n int, move bool) {
	<form class="acts" method="post" action={ templ.SafeURL(b.Base + "/behaviour") }>
		<input type="hidden" name="i" value={ strconv.Itoa(i) }/>
		<input type="hidden" name="v" value={ b.Version }/>
		<a class="btn quiet" href={ templ.SafeURL(b.Base + "/behaviour?tab=" + tabOf(kind) + "&edit=" + kind + "-" + strconv.Itoa(i)) }>Edit</a>
		if move {
			<button class="btn quiet" type="submit" name="op" value={ kind + "-up" } disabled?={ i == 0 } aria-label="Move up">↑</button>
			<button class="btn quiet" type="submit" name="op" value={ kind + "-down" } disabled?={ i == n-1 } aria-label="Move down">↓</button>
		}
		<button class="btn quiet" type="submit" name="op" value={ kind + "-del" } data-confirm={ "Delete " + kind + " " + strconv.Itoa(i+1) + "?" }>Delete</button>
	</form>
}

templ ruleList(b behaviourView) {
	if len(b.Config.Rules) == 0 {
		<p class="empty">No rules: every request gets the default reply.</p>
	} else {
		<ol class="items">
			for i, rule := range b.Config.Rules {
				<li id={ "rule-" + strconv.Itoa(i) } class={ templ.KV("saved", b.Saved == "rule-"+strconv.Itoa(i)) }>
					<span class="no">{ strconv.Itoa(i + 1) }</span>
					<span class="what">
						<b>{ rule.When.Label() }</b> → { rule.Action() }
						if b.Config.Forward != nil && rule.Forward {
							· the receiver gets it too
						} else if b.Config.Forward != nil {
							· not forwarded
						}
					</span>
					@rowActions(b, "rule", i, len(b.Config.Rules), true)
				</li>
			}
		</ol>
		<p class="help">The first rule whose condition holds decides; the rest are skipped.</p>
	}
	if asksToWait(b.Config) {
		<p class="help">A reply here sends <code>Retry-After</code>. <a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=check-new&kind=backoff") }>Add a check that the sender waits</a>: a retry that comes earlier fails it.</p>
	}
}

templ checkList(b behaviourView) {
	if len(b.Config.Checks) == 0 {
		<p class="empty">No checks: every request goes on to the rules.</p>
	} else {
		<ol class="items">
			for i, ch := range b.Config.Checks {
				<li id={ "check-" + strconv.Itoa(i) } class={ templ.KV("saved", b.Saved == "check-"+strconv.Itoa(i)) }>
					<span class="no">{ strconv.Itoa(i + 1) }</span>
					if ch.GivesVerdict() {
						<span class="what">
							<b>{ ch.Label() }</b> · { ch.Summary() }
							if sc, ok := b.Config.SecretByName(ch.Secret); ok && ch.Kind != emulate.KindSchema && !sc.Set() {
								· <a class="unset" href={ templ.SafeURL(b.Base + "/behaviour?tab=secrets") }>{ ch.Secret } not set: n/v</a>
							}
						</span>
					} else {
						<span class="what"><b>{ ch.Header }</b> { ch.Summary() }</span>
					}
					@rowActions(b, "check", i, len(b.Config.Checks), false)
				</li>
			}
		</ol>
	}
}

templ varList(b behaviourView) {
	if len(b.Config.Vars) == 0 {
		<p class="empty">No variables.</p>
	} else {
		<ol class="items">
			for i, v := range b.Config.Vars {
				<li id={ "var-" + strconv.Itoa(i) } class={ templ.KV("saved", b.Saved == "var-"+strconv.Itoa(i)) }>
					<span class="no">{ strconv.Itoa(i + 1) }</span>
					<span class="what"><b>{ v.Name }</b> = { v.Value }</span>
					@rowActions(b, "var", i, len(b.Config.Vars), false)
				</li>
			}
		</ol>
	}
}

templ secretList(b behaviourView) {
	if len(b.Config.Secrets) == 0 {
		<p class="empty">No secrets. Authorization checks need one: a signing key or a token.</p>
	} else {
		<ol class="items">
			for i, sc := range b.Config.Secrets {
				<li id={ "secret-" + strconv.Itoa(i) } class={ templ.KV("saved", b.Saved == "secret-"+strconv.Itoa(i)) }>
					<span class="no">{ strconv.Itoa(i + 1) }</span>
					<span class="what">
						<b>{ sc.Name }</b> · { emulate.SecretKindTitle(sc.Kind) } ·
						if sc.Set() {
							fingerprint <code>{ sc.Fingerprint }</code> · 
						} else {
							<b class="unset">not set</b> · 
						}
						if len(b.Config.SecretUsers(sc.Name)) == 0 {
							not used: <a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=check-new&secret=" + sc.Name) }>add a check</a>
						} else {
							{ secretUse(b.Config, sc.Name) }
						}
					</span>
					<form class="acts" method="post" action={ templ.SafeURL(b.Base + "/behaviour") }>
						<input type="hidden" name="i" value={ strconv.Itoa(i) }/>
						<input type="hidden" name="v" value={ b.Version }/>
						if sc.Set() {
							<a class="btn quiet" href={ templ.SafeURL(b.Base + "/behaviour?tab=secrets&edit=secret-" + strconv.Itoa(i)) }>Replace</a>
						} else {
							<a class="btn quiet" href={ templ.SafeURL(b.Base + "/behaviour?tab=secrets&edit=secret-" + strconv.Itoa(i)) }>Set value</a>
						}
						<button class="btn quiet" type="submit" name="op" value="secret-del" data-confirm={ "Delete secret " + sc.Name + "?" }>Delete</button>
					</form>
				</li>
			}
		</ol>
	}
}

templ schemaList(b behaviourView) {
	if len(b.Config.Schemas) == 0 {
		<p class="empty">No schemas. A JSON Schema check needs one.</p>
	} else {
		<ol class="items">
			for i, sc := range b.Config.Schemas {
				<li id={ "schema-" + strconv.Itoa(i) } class={ templ.KV("saved", b.Saved == "schema-"+strconv.Itoa(i)) }>
					<span class="no">{ strconv.Itoa(i + 1) }</span>
					<span class="what">
						<b>{ sc.Name }</b> · { schemaDraft(sc.Text) } · { size(int64(len(sc.Text))) } ·
						if len(b.Config.SchemaUsers(sc.Name)) == 0 {
							not used: <a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=check-new&schema=" + sc.Name) }>add a check</a>
						} else {
							{ schemaUse(b.Config, sc.Name) }
						}
					</span>
					@rowActions(b, "schema", i, len(b.Config.Schemas), false)
				</li>
			}
		</ol>
	}
}

templ replySummary(r emulate.Reply) {
	<dl class="summary">
		<dt>Status</dt>
		<dd>{ strconv.Itoa(r.Status) }</dd>
		<dt>Delay</dt>
		<dd>{ r.DelayLabel() }</dd>
		<dt>Headers</dt>
		<dd>
			if len(r.Headers) == 0 {
				none
			} else {
				<pre>{ emulate.FormatHeaders(r.Headers) }</pre>
			}
		</dd>
		<dt>Body</dt>
		<dd>
			if r.BodyBase64 != "" {
				<pre>{ r.BodyBase64 }</pre>
				<p class="note">bytes, base64: { size(rawSize(r.BodyBase64)) }</p>
			} else if r.Body == "" {
				empty
			} else {
				<pre>{ r.Body }</pre>
			}
		</dd>
	</dl>
}

// editorDialog creates or edits one item; it opens over the list and closes
// back to it.
templ editorDialog(b behaviourView, e *editor) {
	<dialog class="modal" data-modal data-close={ b.Base + "/behaviour?tab=" + b.Tab } open aria-labelledby="dialog-title">
		<form class="card" method="post" action={ templ.SafeURL(b.Base + "/behaviour") } enctype={ formEnctype(e) }>
			<div class="modal-head">
				<h2 id="dialog-title">{ editorTitle(e) }</h2>
				<a class="close" href={ templ.SafeURL(b.Base + "/behaviour?tab=" + b.Tab) } aria-label="Close">×</a>
			</div>
			if b.Error != "" {
				<p class="error banner" role="alert">Not saved: { b.Error }</p>
			}
			<input type="hidden" name="v" value={ b.Version }/>
			switch e.Kind {
				case "rule":
					<input type="hidden" name="op" value="rule-save"/>
					<input type="hidden" name="i" value={ e.I }/>
					@ruleFields(b, e.Rule)
				case "check":
					<input type="hidden" name="op" value="check-save"/>
					<input type="hidden" name="i" value={ e.I }/>
					@checkFields(b, e.Check)
				case "event":
					<input type="hidden" name="op" value="event"/>
					@eventFields(e.Event, e.Suggested)
				case "secret":
					<input type="hidden" name="op" value="secret-save"/>
					<input type="hidden" name="i" value={ e.I }/>
					@secretFields(e)
				case "schema":
					<input type="hidden" name="op" value="schema-save"/>
					<input type="hidden" name="i" value={ e.I }/>
					@schemaFields(e)
				case "receiver":
					<input type="hidden" name="op" value="receiver"/>
					@receiverFields(b, e.Forward)
				case "var":
					<input type="hidden" name="op" value="var-save"/>
					<input type="hidden" name="i" value={ e.I }/>
					<div class="grid2">
						<label>Name <input name="name" value={ e.Var.Name } required spellcheck="false" autocomplete="off" autofocus placeholder="TOKEN"/></label>
						<label>Value <input name="value" value={ e.Var.Value } spellcheck="false" autocomplete="off" placeholder="tok_test"/></label>
					</div>
					<p class="help">Letters, digits and _, not starting with a digit. Use as <code>{ "{{.Var." + varOrName(e.Var.Name) + "}}" }</code>.</p>
				default:
					<input type="hidden" name="op" value="default"/>
					@replyFields(b, "default", "", e.Reply)
			}
			<div class="acts">
				<button class="btn solid" type="submit">{ editorSave(e) }</button>
				<a class="btn quiet" href={ templ.SafeURL(b.Base + "/behaviour?tab=" + b.Tab) }>Cancel</a>
			</div>
			if e.Kind != "var" && e.Kind != "secret" && e.Kind != "schema" && e.Kind != "event" && e.Kind != "receiver" {
				@templateRef()
			}
		</form>
	</dialog>
}

templ receiverSummary(b behaviourView) {
	if f := b.Config.Forward; f != nil {
		<div class="receiver">
			<p class="receiver-target"><span aria-hidden="true">→</span> <code>{ f.Where() }</code></p>
			<p class="note">{ f.Summary(b.MaxWait) }</p>
			if openRelay(b.Config) {
				<p class="banner warn" role="note">
					Anyone who reaches this endpoint's URL reaches the receiver, answers included.
					<a href={ templ.SafeURL(b.Base + "/behaviour?tab=checks&edit=check-new") }>Add an enforced authorization check</a>.
				</p>
			}
			if b.MayForward {
				<form method="post" action={ templ.SafeURL(b.Base + "/behaviour") }>
					<input type="hidden" name="op" value="receiver-del"/>
					<input type="hidden" name="v" value={ b.Version }/>
					<button class="btn quiet" type="submit">Remove receiver</button>
				</form>
			}
		</div>
	} else {
		<p class="empty">No receiver: this endpoint answers every request itself.</p>
	}
}

templ receiverFields(b behaviourView, f emulate.Forward) {
	<label>URL <input name="url" value={ f.URL } required spellcheck="false" autocomplete="off" autofocus placeholder="https://receiver.example/webhooks"/></label>
	<p class="help">http or https, with no query (the sender's own query goes with each request) and no user name or password. The target policy (<code>-replay-allow</code>) applies.</p>
	<div class="grid2">
		<label>
			Host sent
			<select name="host">
				<option value="target" selected?={ !f.KeepHost }>the receiver's</option>
				<option value="received" selected?={ f.KeepHost }>as received</option>
			</select>
		</label>
		<label>Timeout, s <input type="number" name="timeout" value={ timeoutField(f) } min="0.1" step="any" placeholder={ secondsOf(b.MaxWait) }/></label>
	</div>
	<label>
		When the receiver fails
		<select name="on_failure">
			<option value="gateway" selected?={ !f.FallsBackToDefault() }>answer 502, or 504 for a timeout</option>
			<option value="default" selected?={ f.FallsBackToDefault() }>answer the default reply</option>
		</select>
	</label>
	<label class="check"><input type="checkbox" name="insecure_tls" checked?={ f.InsecureTLS }/> Accept any TLS certificate</label>
	<p class="help">Each request goes as it arrived: its header lines in order and case, its body's bytes, as HTTP/1.1, a chunked body as one chunk. Redirects are not followed. The answer passes back whole up to 1 MiB, its first 64 KiB are kept. With the default reply on failure the sender stays happy, and the receiver misses those requests.</p>
}

templ templateRef() {
	<details class="help" id="templates">
		<summary>Templates in headers and bodies</summary>
		<p class="note">Header values and bodies are Go templates. They can use the request and the variables:</p>
		<pre>{ templateHelp }</pre>
	</details>
}

templ replyFields(b behaviourView, id, prefix string, r emulate.Reply) {
	<div class="grid3">
		<label>Status <input type="number" name={ prefix + "status" } value={ strconv.Itoa(r.Status) } min="200" max="599" required/></label>
		<label>Delay, ms <input type="number" name={ prefix + "delay" } value={ ms(r.DelayMs) } min="0" placeholder="0"/></label>
		<label>+ random jitter, ms <input type="number" name={ prefix + "jitter" } value={ ms(r.JitterMs) } min="0" placeholder="0"/></label>
	</div>
	<label for={ id + "-headers" }>Headers, one per line as <code>Name: value</code></label>
	<textarea id={ id + "-headers" } name={ prefix + "headers" } rows="3" spellcheck="false" placeholder="Content-Type: application/json">{ emulate.FormatHeaders(r.Headers) }</textarea>
	<div class="body-as">
		<label for={ id + "-body" }>Body</label>
		<select name={ prefix + "body_as" } aria-label="Body as">
			<option value="template" selected?={ r.BodyBase64 == "" }>a template</option>
			<option value="base64" selected?={ r.BodyBase64 != "" }>bytes, base64</option>
		</select>
	</div>
	<textarea id={ id + "-body" } name={ prefix + "body" } rows="4" spellcheck="false">{ replyBodyText(r) }</textarea>
	<p class="help">Delay plus jitter up to { span(b.MaxWait) }. Content-Length, Transfer-Encoding and Connection are set by the server.</p>
}

templ ruleFields(b behaviourView, rule emulate.Rule) {
	<div class="grid3 when">
		<label>
			When
			<select name="when" autofocus>
				<option value="every" selected?={ rule.When.Kind == "every" }>every Nth request</option>
				<option value="first" selected?={ rule.When.Kind == "first" }>the first N requests</option>
				<option value="random" selected?={ rule.When.Kind == "random" }>at random, p%</option>
				<option value="window" selected?={ rule.When.Kind == "window" }>within a time after the start</option>
				<option value="flap" selected?={ rule.When.Kind == "flap" }>flapping: down, then up, again</option>
				<option value="rate" selected?={ rule.When.Kind == "rate" }>over a rate, then blocked</option>
				<option value="attempts" selected?={ rule.When.Kind == "attempts" }>the first N attempts of each event</option>
			</select>
		</label>
		<label class="whened w-every w-first w-rate w-attempts">N <input type="number" name="n" value={ blank(rule.When.N) } min="1"/></label>
		<label class="whened w-random">p, % <input type="number" name="percent" value={ percent(rule.When.Percent) } min="0" max="100" step="any"/></label>
		<label class="whened w-window">From, s <input type="number" name="from_s" value={ blankF(rule.When.FromS) } min="0" step="any" placeholder="0"/></label>
		<label class="whened w-window">Until, s <input type="number" name="to_s" value={ blankF(rule.When.ToS) } min="0" step="any" placeholder="for ever"/></label>
		<label class="whened w-flap">Down <input type="number" name="down" value={ blankF(rule.When.Down) } min="0" step="any"/></label>
		<label class="whened w-flap">Up <input type="number" name="up" value={ blankF(rule.When.Up) } min="0" step="any"/></label>
		<label class="whened w-flap">
			Counted in
			<select name="unit">
				<option value="s" selected?={ rule.When.Unit != "requests" }>seconds</option>
				<option value="requests" selected?={ rule.When.Unit == "requests" }>requests</option>
			</select>
		</label>
		<label class="whened w-rate">Per, s <input type="number" name="per_s" value={ blankF(rule.When.PerS) } min="0" step="any"/></label>
		<label class="whened w-rate">Block, s <input type="number" name="block_s" value={ blankF(rule.When.BlockS) } min="0" step="any"/></label>
	</div>
	<p class="help whened w-window w-flap w-rate">The clock starts at the first request the rules see after a reset (or after the endpoint is made); "Reset counter and clock" starts it again. Times up to 604800 s, a week.</p>
	<p class="help whened w-window">It holds between From and Until seconds after the start. With Until blank it never ends, as a resource that is gone after a while.</p>
	<p class="help whened w-flap">Each cycle starts with its down part, when this rule takes the requests, then the up part, when they go on to the next rules.</p>
	<p class="help whened w-rate">More than N requests within Per seconds trip it; it then takes every request during the next Block seconds, and the count starts again. It counts every request the rules see, also those an earlier rule takes.</p>
	<p class="help whened w-attempts">Attempts of the same event: its id where the endpoint's event id says (the Checks tab), else the same body. A request without the id is a first attempt.</p>
	<p class="help whened w-window w-flap w-rate w-attempts">A reply can say <code>{ "{{.RetryAfter}}" }</code> (seconds until this condition ends, e.g. in a <code>Retry-After</code> header), <code>{ "{{.Elapsed}}" }</code> (seconds since the start) and <code>{ "{{.Attempt}}" }</code>.</p>
	if b.Config.Forward != nil {
		<label class="check"><input type="checkbox" name="forward" checked?={ rule.Forward }/> The receiver gets these requests too</label>
		<p class="help">On: the receiver gets each request this rule takes, while the sender gets the rule's answer (a receiver that processed it, a sender that saw a failure). Off: the receiver never sees them.</p>
	}
	<label>
		Do
		<select name="do">
			<option value="reply" selected?={ rule.Do == "reply" }>reply as below</option>
			<option value="timeout" selected?={ rule.Do == "timeout" }>time out: hold, never answer</option>
			<option value="drop" selected?={ rule.Do == "drop" }>drop: reset the connection</option>
		</select>
	</label>
	<div class="reply-fields">
		@replyFields(b, "rule", "", replyOrDefault(rule))
	</div>
	<p class="help for-hold">No reply is sent: the request is still recorded. A timeout holds the connection up to { span(b.MaxWait) }.</p>
}

templ checkFields(b behaviourView, ch emulate.Check) {
	<label>
		Kind
		<select name="kind" autofocus>
			<option value="header" selected?={ checkKind(ch) == "header" }>{ kindTitle("header") }</option>
			for _, k := range emulate.AuthKinds {
				<option value={ k } selected?={ checkKind(ch) == k }>{ kindTitle(k) }</option>
			}
			<option value="schema" selected?={ checkKind(ch) == "schema" }>{ kindTitle("schema") }</option>
			for _, k := range emulate.DeliveryKinds {
				<option value={ k } selected?={ checkKind(ch) == k }>{ kindTitle(k) }</option>
			}
		</select>
	</label>
	<p class="help kinded k-duplicates k-order k-backoff">Judged against the earlier kept requests of the same event (the endpoint's event id: the line above the checks; without one, the same body). Records a verdict, never refuses.</p>
	<p class="help kinded k-duplicates">A repeat of an event fails when an earlier attempt was answered 2xx: the sender delivered twice what the receiver had already taken. A retry after a failure, a timeout or a drop passes.</p>
	<div class="kinded k-order">
		<div class="grid3">
			<label>
				Order by
				<select name="order_from">
					<option value="body" selected?={ ch.Order == nil || ch.Order.From == "body" }>a value in the body</option>
					<option value="header" selected?={ ch.Order != nil && ch.Order.From == "header" }>a header</option>
				</select>
			</label>
			<label>Pointer or header <input name="order_key" value={ orderKey(ch) } spellcheck="false" autocomplete="off" placeholder="/created"/></label>
			<label>
				As
				<select name="order_as">
					<option value="number" selected?={ ch.Order == nil || ch.Order.As == "number" }>a sequence number</option>
					<option value="time" selected?={ ch.Order != nil && ch.Order.As == "time" }>a time (RFC 3339 or unix seconds)</option>
				</select>
			</label>
		</div>
		<div class="grid2">
			<label>
				Within each value of
				<select name="group_from">
					<option value="" selected?={ ch.Group == nil }>nothing: one order for all</option>
					<option value="body" selected?={ ch.Group != nil && ch.Group.From == "body" }>a value in the body</option>
					<option value="header" selected?={ ch.Group != nil && ch.Group.From == "header" }>a header</option>
				</select>
			</label>
			<label>Pointer or header <input name="group_key" value={ groupKey(ch) } spellcheck="false" autocomplete="off" placeholder="/data/object/id"/></label>
		</div>
		<p class="help">A value lower than another event's earlier one fails; ties pass, and a retry of an earlier event is judged on its first delivery.</p>
	</div>
	<div class="kinded k-backoff">
		<div class="grid3">
			<label>First gap, s <input type="number" name="first_s" value={ blankF(ch.FirstS) } min="0" step="any" placeholder="5"/></label>
			<label>Factor <input type="number" name="factor" value={ blankF(ch.Factor) } min="1" step="any" placeholder="2"/></label>
			<label>Longest gap, s <input type="number" name="max_s" value={ blankF(ch.MaxS) } min="0" step="any" placeholder="none"/></label>
		</div>
		<div class="grid2">
			<label>At most attempts <input type="number" name="max_attempts" value={ blankF(float64(ch.MaxAttempts)) } min="0" placeholder="no limit"/></label>
			<label>Tolerance, % <input type="number" name="tolerance_pct" value={ blankF(float64(ch.TolerancePct)) } min="0" max="100" placeholder="25"/></label>
		</div>
		<label class="check"><input type="checkbox" name="retry_after" checked?={ ch.RetryAfter == nil || *ch.RetryAfter }/> A retry before the previous answer's Retry-After fails (and Retry-After wins when longer)</label>
		<p class="help">Each gap is measured from the end of the previous attempt (its reply's delay, or a hold) to the next one: first gap × factor for each later attempt, at most the longest gap. Leave the first gap empty to judge only Retry-After.</p>
	</div>
	<div class="kinded k-schema">
		<div class="grid2">
			<label>
				Pick the schema by
				<select name="select_from">
					<option value="" selected?={ ch.Select == nil }>nothing: the same for every request</option>
					<option value="body" selected?={ ch.Select != nil && ch.Select.From == "body" }>a value in the body (JSON pointer)</option>
					<option value="header" selected?={ ch.Select != nil && ch.Select.From == "header" }>a header</option>
				</select>
			</label>
		</div>
		<fieldset class="masks for-schema">
			<legend>Schemas · the body must match one</legend>
			<div class="mask-list">
				for _, sc := range b.Config.Schemas {
					<label class="check"><input type="checkbox" name="schema" value={ sc.Name } checked?={ checkUses(ch, sc.Name) }/> <code>{ sc.Name }</code></label>
				}
			</div>
			<p class="help">Tick more than one when the sender may send either shape (v1 or v2): the verdict names the one that matched, or the closest one and its problems.</p>
		</fieldset>
		<div class="for-select">
			<label>Pointer or header <input name="select_key" value={ selectKey(ch) } spellcheck="false" autocomplete="off" placeholder="/type or X-GitHub-Event"/></label>
			<label for="check-map">Values to schemas, one per line as <code>value = SchemaName</code></label>
			<textarea id="check-map" name="select_map" rows="3" spellcheck="false" placeholder="order.paid = OrderPaid">{ formatMapping(ch.Select) }</textarea>
			<p class="help">The value at the pointer, or of the header, picks the schema from these lines.</p>
			<fieldset class="masks">
				<legend>Other values, or none · default</legend>
				<div class="mask-list">
					for _, sc := range b.Config.Schemas {
						<label class="check"><input type="checkbox" name="select_default" value={ sc.Name } checked?={ ch.Select != nil && slices.Contains(ch.Select.Default, sc.Name) }/> <code>{ sc.Name }</code></label>
					}
				</div>
				<p class="help">A value without a line, or a request without the value, must match one of the ticked schemas. Tick none to leave such requests unchecked: verdict <b>n/c</b>, never refused.</p>
			</fieldset>
		</div>
	</div>
	<label class="kinded k-header k-hmac">Header <input name="header" value={ ch.Header } spellcheck="false" autocomplete="off" placeholder="X-Signature"/></label>
	<div class="grid2 kinded k-header">
		<label>
			Must
			<select name="match">
				<option value="present" selected?={ ch.Match == "present" }>be present</option>
				<option value="equals" selected?={ ch.Match == "equals" }>equal</option>
				<option value="regex" selected?={ ch.Match == "regex" }>match the regex</option>
			</select>
		</label>
		<label>Value <input name="value" value={ ch.Value } spellcheck="false" autocomplete="off"/></label>
	</div>
	<div class="grid2 kinded k-github k-stripe k-standard k-hmac k-bearer k-basic">
		<label>
			Secret
			<select name="secret">
				<option value="">choose…</option>
				for _, sc := range b.Config.Secrets {
					<option value={ sc.Name } selected?={ ch.Secret == sc.Name }>{ sc.Name } ({ emulate.SecretKindTitle(sc.Kind) })</option>
				}
			</select>
		</label>
		<label class="kinded k-basic">User <input name="user" value={ ch.User } spellcheck="false" autocomplete="off"/></label>
		<label class="kinded k-stripe k-standard">Tolerance, s <input type="number" name="tolerance_s" value={ blank(ch.ToleranceS) } min="1" max="86400" placeholder="300"/></label>
	</div>
	<div class="grid3 kinded k-hmac">
		<label>
			Algorithm
			<select name="algo">
				for _, a := range []string{"sha256", "sha1", "sha512"} {
					<option value={ a } selected?={ ch.Algo == a }>{ a }</option>
				}
			</select>
		</label>
		<label>
			Encoding
			<select name="encoding">
				<option value="hex" selected?={ ch.Encoding != "base64" }>hex</option>
				<option value="base64" selected?={ ch.Encoding == "base64" }>base64</option>
			</select>
		</label>
		<label>Prefix <input name="prefix" value={ ch.Prefix } spellcheck="false" autocomplete="off" placeholder="sha256="/></label>
	</div>
	<label class="kinded k-hmac" for="check-content">Signed content: a template, empty means the raw body</label>
	<textarea class="kinded k-hmac" id="check-content" name="content" rows="2" spellcheck="false" placeholder="{{.Body}}">{ ch.Content }</textarea>
	<label class="check kinded k-stripe k-standard"><input type="checkbox" name="ignore_timestamp" checked?={ ch.IgnoreTimestamp }/> Accept any timestamp (replayed captures)</label>
	<label class="check kinded k-github k-stripe k-standard k-hmac k-bearer k-basic k-schema"><input type="checkbox" name="enforce" checked?={ ch.Enforce }/> Enforce: refuse a request that does not pass (otherwise it gets the usual reply and only the verdict is recorded)</label>
	<label class="check kinded k-header k-github k-stripe k-standard k-hmac k-bearer k-basic k-schema"><input type="checkbox" name="own_error" checked?={ ch.Error != nil }/> Refuse with my own reply (otherwise 400 naming the header, 401, or 400 listing the schema problems)</label>
	<div class="reply-fields kinded k-header k-github k-stripe k-standard k-hmac k-bearer k-basic k-schema">
		@replyFields(b, "check", "error_", errorOrStandard(ch))
	</div>
}

// eventFields edits where the sender puts an event's id: a preset or a
// header or body value of one's own.
templ eventFields(src emulate.Source, suggested string) {
	<p class="help">The id a sender keeps on every retry of an event. Attempts, retry groups and the delivery checks follow it; without one they follow the body, so a sender that changes a field on each attempt starts a new group each time.</p>
	if suggested != "" {
		<p class="note">None is set yet. { suggested }'s is chosen below because the endpoint checks { suggested }'s signature: save to use it.</p>
	}
	<label>
		Event id
		<select name="preset" autofocus>
			<option value="" selected?={ src.Key == "" }>none: the same body is the same event</option>
			for _, p := range emulate.EventPresets {
				<option value={ p.Name } selected?={ src == p.Source }>{ p.Name }: { p.Source.String() }</option>
			}
			<option value="custom" selected?={ src.Key != "" && !isPreset(src) }>my own…</option>
		</select>
	</label>
	<div class="grid2">
		<label>
			From
			<select name="event_from">
				<option value="header" selected?={ src.From != "body" }>a header</option>
				<option value="body" selected?={ src.From == "body" }>a value in the body (JSON pointer)</option>
			</select>
		</label>
		<label>Header or pointer <input name="event_key" value={ src.Key } spellcheck="false" autocomplete="off" placeholder="X-Event-Id or /id"/></label>
	</div>
	<p class="help">"My own" uses these two fields.</p>
}

templ secretFields(e *editor) {
	if e.I == "new" {
		<div class="grid2">
			<label>Name <input name="name" value={ e.Secret.Name } required spellcheck="false" autocomplete="off" autofocus placeholder="WEBHOOK_SECRET"/></label>
			<label>
				Kind
				<select name="secret_kind">
					<option value="key" selected?={ e.Secret.Kind != "token" }>signing key (GitHub, Stripe, Standard Webhooks, HMAC)</option>
					<option value="token" selected?={ e.Secret.Kind == "token" }>token or password (bearer, basic)</option>
				</select>
			</label>
		</div>
	} else {
		if e.Secret.Set() {
			<p class="note"><b>{ e.Secret.Name }</b> · { emulate.SecretKindTitle(e.Secret.Kind) } · now <code>{ e.Secret.Fingerprint }</code>. The new value replaces it; the checks that use it keep working with the new one.</p>
		} else {
			<p class="note"><b>{ e.Secret.Name }</b> · { emulate.SecretKindTitle(e.Secret.Kind) } · not set. Until it has a value, the checks that use it give n/v and refuse nothing.</p>
		}
	}
	<label>Value <input type="password" name="value" value="" required autocomplete="new-password" spellcheck="false"/></label>
	<p class="help">Stored sealed (signing keys) or as a salted hash (tokens and passwords) and never shown again. Use test and staging secrets only: whoever can open this page can use them to sign requests.</p>
}

templ schemaFields(e *editor) {
	if d := e.Draft; d != nil {
		<input type="hidden" name="draft_from" value={ d.From }/>
		<p class="help">Drafted from { d.From }. Review it: a draft knows only what those bodies had.</p>
		if d.Exists {
			<fieldset class="masks">
				<legend>Against the stored { e.Schema.Name } · saving replaces it</legend>
				if len(d.Changes) == 0 {
					<p class="help">No differences in keys, types or formats.</p>
				} else {
					<ul class="changes">
						for _, c := range d.Changes {
							<li><code>{ c }</code></li>
						}
					</ul>
				}
			</fieldset>
		}
		if d.MapCheck > 0 {
			<input type="hidden" name="map_check" value={ strconv.Itoa(d.MapCheck) }/>
			<input type="hidden" name="map_value" value={ d.MapValue }/>
			<input type="hidden" name="map_label" value={ d.MapLabel }/>
			<label class="check"><input type="checkbox" name="map" checked/> Also map <code>{ d.MapValue }</code> to this schema in check { strconv.Itoa(d.MapCheck) } ({ d.MapLabel })</label>
		}
	}
	<label>Name <input name="name" value={ e.Schema.Name } required spellcheck="false" autocomplete="off" autofocus placeholder="OrderPaid"/></label>
	<label for="schema-text">Schema (JSON)</label>
	<textarea id="schema-text" name="text" rows="14" spellcheck="false" placeholder="{&#34;type&#34;: &#34;object&#34;}">{ e.Schema.Text }</textarea>
	<label>Or upload a file <input type="file" name="file" accept=".json,application/json,application/schema+json"/></label>
	<p class="help">A file replaces the text above; up to 1 MiB. Refer to this endpoint's other schemas by name (<code>{ `"$ref": "Address"` }</code>); any other reference is refused.</p>
}
