#!/bin/bash
# Refuse a commit message matching the maintainer's local deny-list
# (.git/info/private-patterns, see pre-commit). Messages are as public as code.
patterns="$(git rev-parse --git-common-dir)/info/private-patterns" # shared by linked worktrees
[ -s "$patterns" ] || exit 0
hits=$(grep -v '^#' "$1" | grep -iE -f "$patterns")
if [ -n "$hits" ]; then
  echo "refusing a commit message with lines that match .git/info/private-patterns:" >&2
  printf '%s\n' "$hits" | sed 's/^/  /' >&2
  exit 1
fi
exit 0
